# HeatMaps — Local-First Environment Configuration
# HeatMaps is a 100% offline-first, client-side application.
# All habit data is stored locally on the user's device (Browser localStorage / IndexedDB / Desktop App Storage).
# No external cloud database or MongoDB connection is required.

NEXT_PUBLIC_APP_NAME="HeatMaps"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
