<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_surface" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HEATMAPS • MONTHLY RHYTHM" android:textColor="#FF9EA2AE" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/month_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFF6F7FA" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/month_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:textColor="#FF5EEA91" android:textSize="11sp" />
    <GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:alignmentMode="alignMargins" android:columnCount="7" android:rowCount="5" android:useDefaultMargins="true">
        <TextView android:id="@+id/month_d1" style="@style/MonthDay" /><TextView android:id="@+id/month_d2" style="@style/MonthDay" /><TextView android:id="@+id/month_d3" style="@style/MonthDay" /><TextView android:id="@+id/month_d4" style="@style/MonthDay" /><TextView android:id="@+id/month_d5" style="@style/MonthDay" /><TextView android:id="@+id/month_d6" style="@style/MonthDay" /><TextView android:id="@+id/month_d7" style="@style/MonthDay" />
        <TextView android:id="@+id/month_d8" style="@style/MonthDay" /><TextView android:id="@+id/month_d9" style="@style/MonthDay" /><TextView android:id="@+id/month_d10" style="@style/MonthDay" /><TextView android:id="@+id/month_d11" style="@style/MonthDay" /><TextView android:id="@+id/month_d12" style="@style/MonthDay" /><TextView android:id="@+id/month_d13" style="@style/MonthDay" /><TextView android:id="@+id/month_d14" style="@style/MonthDay" />
        <TextView android:id="@+id/month_d15" style="@style/MonthDay" /><TextView android:id="@+id/month_d16" style="@style/MonthDay" /><TextView android:id="@+id/month_d17" style="@style/MonthDay" /><TextView android:id="@+id/month_d18" style="@style/MonthDay" /><TextView android:id="@+id/month_d19" style="@style/MonthDay" /><TextView android:id="@+id/month_d20" style="@style/MonthDay" /><TextView android:id="@+id/month_d21" style="@style/MonthDay" />
        <TextView android:id="@+id/month_d22" style="@style/MonthDay" /><TextView android:id="@+id/month_d23" style="@style/MonthDay" /><TextView android:id="@+id/month_d24" style="@style/MonthDay" /><TextView android:id="@+id/month_d25" style="@style/MonthDay" /><TextView android:id="@+id/month_d26" style="@style/MonthDay" /><TextView android:id="@+id/month_d27" style="@style/MonthDay" /><TextView android:id="@+id/month_d28" style="@style/MonthDay" />
        <TextView android:id="@+id/month_d29" style="@style/MonthDay" /><TextView android:id="@+id/month_d30" style="@style/MonthDay" /><TextView android:id="@+id/month_d31" style="@style/MonthDay" />
    </GridLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Tap to open HeatMaps" android:textColor="#FF9EA2AE" android:textSize="10sp" />
</LinearLayout>
