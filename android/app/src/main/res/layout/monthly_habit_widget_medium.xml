<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_surface" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HEATMAPS • MONTHLY RHYTHM" android:textColor="#FF9EA2AE" android:textSize="9sp" android:textStyle="bold" />
    <TextView android:id="@+id/month_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFF6F7FA" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/month_stat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/widget_streak_pill" android:textColor="#FF5EEA91" android:textSize="17sp" android:textStyle="bold" />
    <ImageView android:id="@+id/month_heatmap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="7dp" android:layout_weight="1" android:contentDescription="Monthly habit calendar" android:scaleType="fitCenter" />
    <TextView android:id="@+id/month_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FF9EA2AE" android:textSize="10sp" />
</LinearLayout>
